# 部署拓扑：单卡 compose.yaml；双卡 compose.yaml:compose.scale.yaml；四卡 compose.yaml:compose.quad.yaml。
# 设置后，build / up / ps / logs 等命令都只需 docker compose，无须重复 -f。
COMPOSE_FILE=compose.yaml

# 对外 HTTP 端口，容器内 API 始终为 3000。
API_PORT=3888
# 第一张 GPU 的设备编号；双卡、四卡的其余编号默认 1 / 2 / 3。
GPU_ID=0
# 每张 GPU 的独立解析进程数；总进程数 = GPU 张数 × PARSE_WORKERS，包含 VIP 进程。
# 例如四卡设为 6，合计 24 个进程；四卡拓扑固定其中 2 个只处理高优任务。
PARSE_WORKERS=2

# 业务接口 Bearer 密钥；留空表示不启用业务鉴权。
PDF_API_KEY=
# 内部 worker 鉴权密钥；初始化脚本自动生成，所有 worker 必须与 API 一致。
WORKER_API_TOKEN=
# 自动从 pyproject.toml 生成的镜像标签，含 MinerU 版本；更新源码后重新运行初始化脚本。
SERVICE_VERSION=

# 以下仅在需要覆盖默认行为时取消注释。未列出的容量、超时等直接使用代码默认值，见 docs/scaling.md。
# Compose 项目名决定容器、网络和数据卷名称；已有部署必须保持原名，避免挂到新数据卷。
# COMPOSE_PROJECT_NAME=mineru
# 模型宿主机路径；不设置时使用 models 命名卷。
# MODEL_DIR=/srv/mineru/models
# 第二张 GPU 的设备编号，双卡、四卡使用，默认 1。
# GPU_ID_B=1
# 第三张 GPU 的设备编号，仅四卡使用，默认 2。
# GPU_ID_C=2
# 第四张 GPU 的设备编号，仅四卡使用，默认 3。
# GPU_ID_D=3
# vLLM 占用显存比例，默认 0.35；需为解析进程的本地模型留出显存。
# GPU_MEMORY_UTILIZATION=0.35
# 镜像仓库受限时可指定镜像源；同时用于 worker 构建和独立推理容器。
# VLLM_IMAGE=vllm/vllm-openai:v0.29.0
# CUDA 13 镜像配合旧驱动时，按主机实测启用兼容库；正常驱动无需设置这两项。
# CUDA_LIBRARY_PATH=/usr/local/cuda/compat:/usr/local/nvidia/lib64:/usr/local/cuda/lib64:/usr/local/nvidia/lib
# vLLM 前向兼容开关，默认 0；旧驱动按实测与上一项兼容库路径配套启用。
# VLLM_ENABLE_CUDA_COMPATIBILITY=1
